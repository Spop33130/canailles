---
// Une photo en pleine largeur avec une légende courte dans le coin : c'est
// le rythme du site, une image, une bande de texte, une image.
// Les originaux font 1 000 px de large ; on ne les agrandit jamais.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  legende?: string;
  // Point de cadrage quand l'image est rognée (valeur CSS object-position).
  cadrage?: string;
  // Seule la photo du premier écran se charge tout de suite.
  prioritaire?: boolean;
  class?: string;
}

const { src, alt, legende, cadrage = '50% 50%', prioritaire = false, class: classe } = Astro.props;
---

<figure class:list={['photo', classe]} style={`--cadrage: ${cadrage};`}>
  <Picture
    src={src}
    formats={['avif', 'webp']}
    widths={[640, 1000]}
    sizes="100vw"
    alt={alt}
    loading={prioritaire ? 'eager' : 'lazy'}
    fetchpriority={prioritaire ? 'high' : 'auto'}
  />
  {legende && <figcaption class="petites-caps">{legende}</figcaption>}
</figure>

<style>
  .photo {
    position: relative;
    margin: 0 auto;
    max-width: var(--page-max);
  }

  .photo :global(img) {
    width: 100%;
    height: min(78svh, 56vw);
    min-height: 16rem;
    object-fit: cover;
    object-position: var(--cadrage);
  }

  .photo figcaption {
    position: absolute;
    left: var(--gutter);
    bottom: var(--space-sm);
    padding: var(--space-3xs) var(--space-2xs);
    background: var(--color-paper);
    color: var(--color-bordeaux);
  }
</style>
