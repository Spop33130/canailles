---
// Pied de page bordeaux : le logo en grand, en crème, et l'essentiel en
// petit. La mention sur l'alcool est obligatoire (loi Évin) dès lors que
// le site parle de vins, whiskys et rhums.
import Logo from './Logo.astro';
import { maison, societe } from '../data/maison';
---

<footer class="pied">
  <div class="pied__interieur page">
    <Logo class="pied__logo" />
    <div class="pied__infos">
      <p>
        {maison.adresse.rue}, {maison.adresse.codePostal} {maison.adresse.ville}<br />
        <a href={maison.telephone.lien}>{maison.telephone.affiche}</a>{' · '}
        <a href={maison.instagram.url} rel="noopener">{maison.instagram.compte}</a>
      </p>
      <p class="pied__legal">
        {societe.raisonSociale}, {societe.forme}{' · '}<a href="/mentions-legales">Mentions légales</a>
      </p>
      <p class="pied__legal">L’abus d’alcool est dangereux pour la santé, à consommer avec modération.</p>
    </div>
  </div>
</footer>

<style>
  .pied {
    padding-block: var(--space-2xl);
    background: var(--color-bordeaux);
    color: var(--color-on-bordeaux);
  }

  .pied__interieur {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .pied :global(.pied__logo) {
    height: clamp(9rem, 6rem + 10vw, 15rem);
    flex: none;
  }

  .pied__infos {
    display: grid;
    gap: var(--space-sm);
    max-width: 30rem;
    text-align: right;
  }

  .pied__legal {
    font-size: var(--text-sm);
    opacity: 0.8;
  }

  .pied :focus-visible {
    outline-color: var(--color-on-bordeaux);
  }

  @media (max-width: 47.99rem) {
    .pied__interieur {
      flex-direction: column;
      align-items: start;
    }

    .pied__infos {
      text-align: left;
    }
  }
</style>
