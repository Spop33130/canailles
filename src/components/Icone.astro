---
// Les trois pictos du site, tracés au trait pour rester dans l'esprit des
// dessins au feutre de la carte papier. Ils sont décoratifs : le texte du
// bouton porte toujours le sens, d'où aria-hidden.
interface Props {
  nom: 'telephone' | 'itineraire' | 'instagram';
}

const { nom } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    nom === 'telephone' && (
      <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11.5 11.5 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16.6 16.6 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z" />
    )
  }
  {
    nom === 'itineraire' && (
      <>
        <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
        <circle cx="12" cy="10" r="2.3" />
      </>
    )
  }
  {
    nom === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
        <circle cx="12" cy="12" r="3.8" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
      </>
    )
  }
</svg>
